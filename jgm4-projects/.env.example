# Valores fictícios. O comando npm run db:start cria .env com senha aleatória.
DATABASE_URL="postgresql://usuario_exemplo:senha_ficticia@127.0.0.1:5433/jgm4_projects?schema=public"
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
# Opcional: pasta bin de uma instalação local PostgreSQL 18.
# PG_BIN="D:/Program Files/PostgreSQL/18/bin"

# Etapa 5.1 — autenticação
# Segredo do JWT (mín. 32 caracteres). Obrigatório em produção; em desenvolvimento, se ausente, a API usa um segredo efêmero.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-64-caracteres-ou-mais
JWT_EXPIRES_IN=8h
# Modo de ator de desenvolvimento (cabeçalho x-actor-role / JGM4_LOCAL_ACTOR). Mantenha false. Ignorado se NODE_ENV=production.
ALLOW_DEV_ACTOR_HEADER=false
# Senha dos usuários de desenvolvimento criados pelo seed (padrão documentado em docs/validacao-etapa-5-1.md).
# Em produção o seed só cria usuários se SEED_USER_PASSWORD for definida.
# SEED_USER_PASSWORD=

# ---------------------------------------------------------------------------------------------------------------
# Etapa 8 — produção externa, segurança e privacidade. TODOS os valores abaixo são fictícios/exemplos.
# Em produção, defina-os no cofre/variáveis do provedor (nunca no repositório). A API recusa subir em produção
# com configuração insegura (veja docs/checklist-producao.md).
# ---------------------------------------------------------------------------------------------------------------
# Ambiente lógico: development | test | staging | production (staging e produção NÃO compartilham banco, segredos nem armazenamento).
APP_ENV=development
# Origens permitidas (CORS), separadas por vírgula, sempre com https:// em produção. Sem curinga.
ALLOWED_ORIGINS=http://localhost:4200
# URL pública do sistema (usada nos links dos e-mails de redefinição/convite).
PUBLIC_URL=http://localhost:4200
# Chave de criptografia de dados sensíveis (AES-256-GCM): 32 bytes em base64. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Chave dos backups criptografados (diferente da chave de dados; guardada FORA do servidor do banco).
BACKUP_ENCRYPTION_KEY=
# Atrás de proxy reverso (nginx/Caddy/balanceador): número de proxies confiáveis para o X-Forwarded-*.
TRUST_PROXY=0
HOST=127.0.0.1
# Exigir MFA (TOTP) de administradores JGM4 (obrigatório em produção).
REQUIRE_MFA_FOR_ADMIN=false
# Limite de tentativas de login por IP em 10 minutos (padrão 60; contas travam após 5 falhas por 15 min).
# RATE_LIMIT_LOGIN_PER_IP=60
# Contato de privacidade exibido em /privacy. Só aparece se definido (o sistema não inventa endereço).
PRIVACY_CONTACT_EMAIL=
# E-mail transacional: smtp | outbox (grava .eml em pasta, só desenvolvimento) | memory (testes).
MAIL_PROVIDER=outbox
MAIL_FROM="JGM4 Projects <nao-responder@exemplo.invalid>"
# MAIL_OUTBOX_DIR=.local/outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Anexos privados (fora da pasta pública). UPLOAD_MAX_MB limita o tamanho; SCAN_REQUIRED=true só libera após varredura antimalware.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local/storage
UPLOAD_MAX_MB=10
SCAN_REQUIRED=false
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# Banco em produção: usuário de mínimo privilégio e TLS.
# DATABASE_SSL=require (ou sslmode=require/verify-full na DATABASE_URL)
# DATABASE_SSL_CA=
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Retenção (dias). AuditLog, Approval e histórico de relatórios NUNCA são apagados por estas rotinas.
# RETENTION_SECURITY_EVENT_DAYS=365
# RETENTION_IP_DAYS=90
# RETENTION_SESSION_DAYS=30
# Primeiro administrador em produção (npm run admin:bootstrap). Senha só no ambiente, nunca no Git.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=
# O seed não cria usuários de teste em produção, salvo ALLOW_PRODUCTION_SEED=true (não recomendado).
# ALLOW_PRODUCTION_SEED=false
# Servir o frontend compilado pela própria API (opcional): FRONTEND_DIST_DIR=frontend/dist/frontend
